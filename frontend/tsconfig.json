{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    // wails3 生成的绑定是 .js + JSDoc（没有 .d.ts），
    // 打开 allowJs 让 TS 直接依据 JSDoc 推断类型，从而保留对绑定调用的基本检查。
    "allowJs": true,
    "maxNodeModuleJsDepth": 2,
    "isolatedModules": true,
    // 测试用 Node 内置运行器直接加载 .ts（见 package.json 的 test 脚本），
    // 而 Node 的 ESM 解析【不补扩展名】—— 于是被测试直接引入的 src 模块
    // （例如 utils/batch.ts 引入 utils/format）必须写成 './format.ts'。
    // 打开这一项让 vue-tsc 接受这种写法（noEmit 已开，不会产出文件）；
    // Vite 对带扩展名的相对导入同样能解析。
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client"]
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.vue"],
  "exclude": ["node_modules", "dist", "bindings"]
}
